# Dependencies (Crucial - prevents committing thousands of node files)
node_modules/
**/node_modules/

# Environment variables & secrets (Crucial for security)
.env
.env.local
*.env

# Build outputs
dist/
build/

# IDE & OS clutter
.vscode/
.DS_Store
Thumbs.db
# Logs
*.log
npm-debug.log*

# User uploads (served by the API, never committed)
backend/uploads/

# Flutter / Android local build state
.dart_tool/
**/.dart_tool/
**/android/local.properties
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
