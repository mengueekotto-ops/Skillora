    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "1. Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "    if (pm.environment) pm.environment.set('authToken', jsonData.data.token);",
                  "}",
                  "if (jsonData && jsonData.data && jsonData.data.user) {",
                  "    pm.collectionVariables.set('userId', jsonData.data.user.id);",
                  "    if (pm.environment) pm.environment.set('userId', jsonData.data.user.id);",
                  "}",
                  "pm.test('Status code is 201 or 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Christian\",\n  \"lastName\": \"Kamga\",\n  \"email\": \"test.customer@skillora.com\",\n  \"phone\": \"+237699112233\",\n  \"password\": \"Password123!\",\n  \"role\": \"CUSTOMER\",\n  \"location\": \"Bastos, Yaoundé\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new customer. Automatically saves the returned token as {{authToken}}."
          }
        },
        {
          "name": "2. Register Professional / Artisan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "    if (pm.environment) pm.environment.set('authToken', jsonData.data.token);",
                  "}",
                  "if (jsonData && jsonData.data && jsonData.data.user) {",
                  "    pm.collectionVariables.set('userId', jsonData.data.user.id);",
                  "    if (pm.environment) pm.environment.set('userId', jsonData.data.user.id);",
                  "    if (jsonData.data.user.professionalProfile) {",
                  "        pm.collectionVariables.set('professionalId', jsonData.data.user.professionalProfile.id);",
                  "        if (pm.environment) pm.environment.set('professionalId', jsonData.data.user.professionalProfile.id);",
                  "    }",
                  "}",
                  "pm.test('Status code is 201 or 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Marc\",\n  \"lastName\": \"Fotso\",\n  \"email\": \"marc.electrician@skillora.com\",\n  \"phone\": \"+237677445566\",\n  \"password\": \"Password123!\",\n  \"role\": \"PROFESSIONAL\",\n  \"location\": \"Akwa, Douala\",\n  \"profession\": \"Electrical Wiring & Fault Finding\",\n  \"bio\": \"Certified electrician specializing in short circuit repair and solar systems.\",\n  \"experience\": 5,\n  \"skills\": [\"Wiring\", \"Generator Switch\", \"Breaker Box\", \"Solar Inverters\"]\n}"
