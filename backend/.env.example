# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/my_project_db

# ── Authentication ───────────────────────────────────────
# REQUIRED. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── AI (OpenRouter) ──────────────────────────────────────
# Leave empty to use the built-in offline question banks and rules
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# ── Payments (DigiPay Mobile Money) ──────────────────────
DIGIPAY_API_KEY=
# production | sandbox
DIGIPAY_ENV=production
# true = fake payments that always succeed (development only, refused in production)
DIGIPAY_MOCK=false
# Orange Money number that receives the platform commission (optional)
PLATFORM_ORANGE_NUMBER=
PLATFORM_FEE_PERCENT=2
